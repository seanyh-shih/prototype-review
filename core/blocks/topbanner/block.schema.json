{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topbanner",
  "title": "Topbanner（頁首主視覺）",
  "description": "頁面最上方的主視覺區塊。依 Figma guideline 共有 3 種互斥格式（variant）：standard（一般格式：影片＋圖片）、before-after（拖曳比較）、slider（自動輪播）。同一個 Topbanner 只會是其中一種，不混用。文字區（標題、說明、按鈕）三種格式共用同一組欄位；Desktop 文字疊在媒體右半、Tablet/Mobile 文字在媒體下方，兩種版面由組裝腳本用同一份內容產生，不需要填兩次。",
  "type": "object",
  "required": [
    "block",
    "variant",
    "heading",
    "body"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "block": {
      "const": "topbanner",
      "description": "區塊 ID，固定值。"
    },
    "variant": {
      "title": "呈現格式",
      "description": "standard＝一般格式（一支循環影片＋一張圖片，成對出現）；before-after＝兩張圖片可拖曳比較；slider＝多組圖片自動輪播。",
      "enum": [
        "standard",
        "before-after",
        "slider"
      ],
      "x-ui": {
        "widget": "select",
        "group": "格式"
      }
    },
    "heading": {
      "title": "主標題（H1）",
      "type": "string",
      "minLength": 1,
      "x-ui": {
        "widget": "text",
        "group": "文案"
      }
    },
    "body": {
      "title": "說明文字",
      "type": "string",
      "minLength": 1,
      "x-ui": {
        "widget": "textarea",
        "group": "文案"
      }
    },
    "ctas": {
      "title": "按鈕",
      "description": "最多 2 個。第一個為主要按鈕。Desktop / Tablet / Mobile 使用同一組文案；若設計稿上三個尺寸的文案不一致，優先懷疑是設計稿疏忽，與設計端確認（見 SPEC.md「提醒」）。",
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "按鈕文字",
            "type": "string",
            "minLength": 1
          },
          "href": {
            "title": "連結",
            "type": "string",
            "default": "#"
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "group": "文案"
      }
    }
  },
  "oneOf": [
    {
      "title": "格式 1：standard（一般格式）",
      "description": "背景是一支循環播放（loop）、靜音的影片，搭配一張圖片（影片載入前或無法播放時顯示的封面）。影片與圖片固定成對出現，三個尺寸各一組。已於 API_AI_Hair_Extension 以影片實作過（原 V1），規格依 DESIGN-RULES §5.11。Figma guideline 原本允許一般格式只用圖片，目前依實際使用情況簡化為成對；若之後出現只有圖片的需求再擴充。",
      "required": [
        "media"
      ],
      "properties": {
        "variant": {
          "const": "standard"
        },
        "media": {
          "title": "背景媒體",
          "type": "object",
          "required": [
            "dt",
            "pd",
            "mb"
          ],
          "additionalProperties": false,
          "properties": {
            "dt": {
              "$ref": "#/$defs/standardSlot",
              "title": "Desktop"
            },
            "pd": {
              "$ref": "#/$defs/standardSlot",
              "title": "Tablet"
            },
            "mb": {
              "$ref": "#/$defs/standardSlot",
              "title": "Mobile"
            }
          },
          "x-ui": {
            "group": "媒體"
          }
        }
      }
    },
    {
      "title": "格式 2：before-after（拖曳比較）",
      "description": "兩張圖片，中間有可拖曳的把手。只能用圖片（jpg/png），不支援影片。已實作並驗證，規格依 DESIGN-RULES §5.10。",
      "required": [
        "images"
      ],
      "properties": {
        "variant": {
          "const": "before-after"
        },
        "images": {
          "title": "圖片",
          "description": "Before 與 After 各需 Desktop / Tablet / Mobile 三個尺寸。",
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "before": {
              "$ref": "#/$defs/deviceImages",
              "title": "Before 圖"
            },
            "after": {
              "$ref": "#/$defs/deviceImages",
              "title": "After 圖"
            }
          },
          "x-ui": {
            "group": "媒體"
          }
        },
        "labels": {
          "title": "Mobile 標籤文字",
          "description": "只在 Mobile 顯示於圖片左上與右上角。Desktop/Tablet 的文字已內建在把手圖，不使用此欄位。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": "string",
              "default": "BEFORE"
            },
            "after": {
              "type": "string",
              "default": "AFTER"
            }
          },
          "x-ui": {
            "group": "進階"
          }
        }
      }
    },
    {
      "title": "格式 3：slider（圖片輪播）【草稿，尚未實測】",
      "description": "多組圖片自動輪播，無導覽點與左右箭頭（SECTIONS.md Section 01 已確認）。實測只有「prompt 提示框」文字會隨輪播改變，主標題與副標題固定。以下欄位依該規格推導，尚未做過 prototype 驗證，實測後可能調整。",
      "required": [
        "slides"
      ],
      "properties": {
        "variant": {
          "const": "slider"
        },
        "slides": {
          "title": "輪播內容",
          "description": "至少 2 組。表單預設顯示 3 組，可用「＋」增加，不設上限（已知專案最多到 4 組）。檔名用兩位數流水號 01、02、03、04…",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "images"
            ],
            "additionalProperties": false,
            "properties": {
              "images": {
                "$ref": "#/$defs/deviceImages",
                "title": "這一張的圖片"
              },
              "prompt": {
                "title": "連動文字（prompt 提示框）",
                "description": "隨這一張圖一起顯示的文字。是否就是 guideline 所指的「會改變的文字」仍待與設計確認。",
                "type": "string",
                "x-ui": {
                  "widget": "text"
                }
              }
            }
          },
          "x-ui": {
            "widget": "list",
            "group": "媒體",
            "defaultCount": 3,
            "addable": true
          }
        },
        "intervalMs": {
          "title": "每張停留時間（毫秒）",
          "description": "待確認：設計稿未明確說明停留秒數與換張過場方式，確認後再決定預設值。",
          "type": "integer",
          "minimum": 1000,
          "x-ui": {
            "group": "進階"
          }
        }
      }
    }
  ],
  "$defs": {
    "deviceImages": {
      "type": "object",
      "required": [
        "dt",
        "pd",
        "mb"
      ],
      "additionalProperties": false,
      "properties": {
        "dt": {
          "title": "Desktop 圖",
          "type": "string",
          "description": "圖片檔路徑",
          "x-ui": {
            "widget": "image"
          }
        },
        "pd": {
          "title": "Tablet 圖",
          "type": "string",
          "description": "圖片檔路徑",
          "x-ui": {
            "widget": "image"
          }
        },
        "mb": {
          "title": "Mobile 圖",
          "type": "string",
          "description": "圖片檔路徑",
          "x-ui": {
            "widget": "image"
          }
        }
      }
    },
    "standardSlot": {
      "type": "object",
      "required": [
        "video",
        "poster"
      ],
      "additionalProperties": false,
      "properties": {
        "video": {
          "title": "影片",
          "type": "string",
          "description": "影片檔路徑（mp4），循環播放、靜音。",
          "x-ui": {
            "widget": "video"
          }
        },
        "poster": {
          "title": "圖片（封面）",
          "type": "string",
          "description": "圖片檔路徑（jpg/png）：影片載入前或無法播放時顯示。",
          "x-ui": {
            "widget": "image"
          }
        }
      }
    }
  },
  "x-notes": [
    "圖片尺寸與檔案大小規格待從 YCO_product page_DESIGN-RULES.md 搬入（Phase 1）。",
    "拖曳把手圖（b_a_sliderContainer 系列）屬於品牌素材，放在 brands/<品牌>/ 下，不是每個專案要填的內容。",
    "Topbanner 的 CTA 還有另一種型態：上傳互動區（Photo Filters & Effects 範例），目前規格只涵蓋純按鈕型，待之後需要時再加。",
    "Desktop 影片編碼注意（AV1 在 Safari 17 以前不支援）見 DESIGN-RULES 的 AV1 相容性提醒，屬素材規格，不在本欄位規格內。",
    "x-ui 是給之後表單頁用的提示，不影響內容驗證。"
  ]
}
